# CrustyRustacean Dev Blog - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Database (Turso) - REQUIRED
# =============================================================================
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# =============================================================================
# S3 Storage (Cloudflare R2, AWS S3, MinIO, etc.) - REQUIRED
# =============================================================================
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: Custom endpoint for S3-compatible services (required for R2/MinIO)
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# =============================================================================
# Application Configuration - REQUIRED
# =============================================================================
JWT_SECRET=your-secure-jwt-secret-key
TEMPLATES_DIR=templates/**/*

# =============================================================================
# CORS Configuration - OPTIONAL
# =============================================================================
# Comma-separated list of allowed origins
# Defaults to http://localhost:8000,http://127.0.0.1:8000
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# Email (Mailtrap) - OPTIONAL
# If not set, emails will be logged instead of sent
# =============================================================================
# MAILTRAP_API_TOKEN=your-mailtrap-api-token
# MAILTRAP_SANDBOX_INBOX_ID=your-sandbox-inbox-id
# MAILTRAP_SENDER_EMAIL=noreply@yourdomain.com
# MAILTRAP_SENDER_NAME=CrustyRustacean Dev Blog

# =============================================================================
# Server Configuration - OPTIONAL
# =============================================================================
# Port to listen on (Railway auto-injects PORT)
# PORT=8000
